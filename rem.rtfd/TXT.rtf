\f1\fs28 \cf2 /* ==========================================================================\
   1. VARIABLES & CONFIGURATION RACINE\
   ========================================================================== */\
html \{\
  /* Base de 10px pour simplifier les calculs (62.5% de 16px) */\
  font-size: 62.5%; \
  box-sizing: border-box;\
\}\
\
*, *::before, *::after \{\
  box-sizing: inherit;\
  margin: 0;\
  padding: 0;\
\}\
\
/* Th\'e8me Clair par d\'e9faut */\
:root \{\
  --bg-site: #f4f6f9;\
  --bg-card: #ffffff;\
  --bg-badge: #007bff;\
  --bg-badge-hot: #dc3545;\
  --text-main: #1a1d20;\
  --text-muted: #5a626a;\
  --shadow: rgba(0, 0, 0, 0.06);\
  --border-color: #e9ecef;\
\}\
\
/* Th\'e8me Sombre automatique (bas\'e9 sur le syst\'e8me de l'utilisateur) */\
@media (prefers-color-scheme: dark) \{\
  :root \{\
    --bg-site: #121212;\
    --bg-card: #1e1e1e;\
    --bg-badge: #0b66c2;\
    --bg-badge-hot: #bb2d3b;\
    --text-main: #f8f9fa;\
    --text-muted: #a0aec0;\
    --shadow: rgba(0, 0, 0, 0.4);\
    --border-color: #2d2d2d;\
  \}\
\}\
\
/* ==========================================================================\
   2. STYLES G\'c9N\'c9RAUX\
   ========================================================================== */\
body \{\
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;\
  background-color: var(--bg-site);\
  color: var(--text-main);\
  /* 1.6rem = 16px */\
  font-size: 1.6rem; \
  line-height: 1.6;\
  padding: 4rem 2rem;\
  transition: background-color 0.3s ease, color 0.3s ease;\
\}\
\
.header \{\
  text-align: center;\
  margin-bottom: clamp(3rem, 5vw, 6rem);\
\}\
\
.header h1 \{\
  /* Taille fluide : min 2.8rem (28px), max 4rem (40px) */\
  font-size: clamp(2.8rem, 4vw, 4rem);\
  margin-bottom: 1rem;\
\}\
\
.header p \{\
  font-size: 1.6rem;\
  color: var(--text-muted);\
\}\
\
/* ==========================================================================\
   3. MISE EN PAGE GLOBAL (GRID)\
   ========================================================================== */\
.grid-container \{\
  display: grid;\
  /* Colonnes automatiques d'au moins 28rem (280px) */\
  grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr));\
  /* Espace fluide entre les cartes */\
  gap: clamp(2rem, 3vw, 4rem);\
  max-width: 114rem; /* 1140px maximum */\
  margin: 0 auto;\
\}\
\
/* ==========================================================================\
   4. COMPOSANT COMPLET (CARD)\
   ========================================================================== */\
.card \{\
  background-color: var(--bg-card);\
  border: 1px solid var(--border-color);\
  border-radius: 1.2rem; /* 12px */\
  overflow: hidden;\
  box-shadow: 0 1rem 2rem var(--shadow);\
  display: flex;\
  flex-direction: column;\
  transition: transform 0.2s ease, box-shadow 0.2s ease;\
\}\
\
/* Effet d'animation simple au survol */\
.card:hover \{\
  transform: translateY(-5px);\
  box-shadow: 0 1.5rem 3rem var(--shadow);\
\}\
\
.card-image-placeholder \{\
  height: 18rem; /* 180px */\
  background-color: var(--border-color);\
  display: flex;\
  align-items: center;\
  justify-content: center;\
  font-size: 5rem;\
\}\
\
.card-content \{\
  padding: 2.4rem; /* 24px */\
  display: flex;\
  flex-direction: column;\
  /* Flex-grow pousse le contenu pour aligner le bas des cartes si le texte varie */\
  flex-grow: 1; \
  gap: 1.2rem; /* 12px d'espace constant entre les \'e9l\'e9ments enfants */\
\}\
\
/* Utilisation id\'e9ale du EM pour le badge autonome */\
.card-badge \{\
  align-self: flex-start; /* \'c9vite que le badge prenne toute la largeur */\
  font-size: 1.1rem; /* 11px */\
  font-weight: bold;\
  text-transform: uppercase;\
  letter-spacing: 0.05em;\
  /* Le padding s'adapte par rapport \'e0 la police du badge (1.1rem) */\
  padding: 0.4em 0.9em; \
  background-color: var(--bg-badge);\
  color: #ffffff;\
  border-radius: 0.4rem;\
\}\
\
.card-badge.badge-hot \{\
  background-color: var(--bg-badge-hot);\
\}\
\
.card-title \{\
  font-size: clamp(2rem, 2.5vw, 2.4rem);\
  font-weight: 700;\
  line-height: 1.2;\
\}\
\
.card-text \{\
  font-size: 1.4rem; /* 14px */\
  color: var(--text-muted);\
\}\
