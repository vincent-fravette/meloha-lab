\f1\fs28 \cf2 /* ==========================================================================\
   3. MISE EN PAGE GLOBALE (SLIDER SUR MOBILE, GRID SUR PC)\
   ========================================================================== */\
.grid-container \{\
  max-width: 114rem; /* 1140px maximum */\
  margin: 0 auto;\
  padding: 2rem;\
\
  /* --- COMPORTEMENT MOBILE PAR D\'c9FAUT (SLIDER) --- */\
  display: flex;\
  overflow-x: auto; /* Active le d\'e9filement horizontal */\
  gap: 2rem;        /* Espace constant entre les cartes sur mobile */\
  \
  /* Masque la barre de d\'e9filement par d\'e9faut pour un look plus propre */\
  scrollbar-width: none; /* Firefox */\
  -ms-overflow-style: none; /* IE/Edge */\
  \
  /* Propri\'e9t\'e9s de Scroll Snap pour aligner les cartes proprement au doigt */\
  scroll-snap-type: x mandatory;\
  scroll-behavior: smooth;\
  \
  /* Ajoute un espace fant\'f4me \'e0 droite pour que la derni\'e8re carte ne colle pas au bord */\
  padding-right: 4rem; \
\}\
\
/* Masque la barre de d\'e9filement pour Chrome, Safari et Opera */\
.grid-container::-webkit-scrollbar \{\
  display: none;\
\}\
\
/* Ajustement des cartes pour le mode Slider sur Mobile */\
.card \{\
  /* Emp\'eache les cartes de r\'e9tr\'e9cir et leur donne une largeur fixe sur mobile */\
  flex: 0 0 28rem; /* 280px */\
  /* Aligne chaque carte sur le d\'e9but de l'\'e9cran lors du d\'e9filement */\
  scroll-snap-align: start; \
\}\
\
\
/* --- PASSAGE EN MODE GRILLE SUR \'c9CRANS LARGES (TABLETTES & PC) --- */\
@media (min-width: 768px) \{\
  .grid-container \{\
    display: grid;\
    /* On r\'e9active la grille automatique */\
    grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr));\
    /* On reprend l'espacement fluide clamp() g\'e9r\'e9 pr\'e9c\'e9demment */\
    gap: clamp(2rem, 3vw, 4rem);\
    /* On remet le padding standard */\
    padding-right: 2rem;\
    overflow-x: visible;\
    scroll-snap-type: none;\
  \}\
\
  .card \{\
    /* On r\'e9initialise la flexibilit\'e9 pour que Grid reprenne le contr\'f4le */\
    flex: initial;\
    scroll-snap-align: none;\
  \}\
\}\
