\b\fs40 \cf2 Fonctionnement de base\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sl360\sa240\partightenfactor0
\ls1\ilvl0
\fs32 \cf2 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 D\'e9finition :
\b0  
\f1\fs28 \uc0\u8234 rem
\f0\fs32 \uc0\u8236  signifie 
\i Root EM
\i0  (EM de la racine).\
\ls1\ilvl0
\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Valeur par d\'e9faut :
\b0  Sur la plupart des navigateurs, la taille de police de l'\'e9l\'e9ment 
\f1\fs28 \uc0\u8234 <html>
\f0\fs32 \uc0\u8236  vaut 16 pixels (
\f1\fs28 \uc0\u8234 16px
\f0\fs32 \uc0\u8236 ).\
\ls1\ilvl0
\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Calcul :
\b0  
\f1\fs28 \uc0\u8234 1rem
\f0\fs32 \uc0\u8236  \'e9quivaut donc \'e0 
\f1\fs28 \uc0\u8234 16px
\f0\fs32 \uc0\u8236  par d\'e9faut. Si vous \'e9crivez 
\f1\fs28 \uc0\u8234 2rem
\f0\fs32 \uc0\u8236 , cela fait 
\f1\fs28 \uc0\u8234 32px
\f0\fs32 \uc0\u8236  (
\f1\fs28 \uc0\u8234 2 \'d7 16px
\f0\fs32 \uc0\u8236 ). [{\field{\*\fldinst{HYPERLINK "https://elementor.com/blog/fr/rem-vs-em-en-css-guide-de-a-a-z/"}}{\fldrslt \cf3 \ul \ulc3 \strokec3 1}}, {\field{\*\fldinst{HYPERLINK "https://www.sitepoint.com/understanding-and-using-rem-units-in-css/"}}{\fldrslt \cf3 \ul \ulc3 \strokec3 2}}, {\field{\*\fldinst{HYPERLINK "https://www.mekaa.co/lexique/rem"}}{\fldrslt \cf3 \ul \ulc3 \strokec3 3}}]\
