\fs28 \cf2 \
\pard\pardeftab720\sl460\partightenfactor0

\fs40 \cf2 css\
\pard\pardeftab720\sl320\partightenfactor0

\f1\fs28 \cf2 /* Taille de base par d\'e9faut pour les mobiles */\
html \{\
  font-size: 50%; /* 1rem = 8px (tr\'e8s compact pour petits \'e9crans) */\
\}\
\
.card \{\
  width: 32rem; /* 32 x 8px = 256px */\
  padding: 2rem; /* 16px */\
\}\
\
.card-title \{\
  font-size: 2.4rem; /* 19.2px */\
\}\
\
/* Sur les \'e9crans plus larges (tablettes et PC), on augmente la base racine */\
@media (min-width: 768px) \{\
  html \{\
    font-size: 62.5%; /* 1rem = 10px (la base standard confortable) */\
  \}\
  \
  .card \{\
    width: 35rem; /* 35 x 10px = 350px */\
  \}\
\}\
\
@media (min-width: 1200px) \{\
  html \{\
    font-size: 75%; /* 1rem = 12px pour les grands moniteurs */\
  \}\
\}\
