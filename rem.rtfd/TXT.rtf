\f1\fs28 \cf2 /* ==========================================================================\
   1. VARIABLES & CONFIGURATION RACINE\
   ========================================================================== */\
html \{\
  font-size: 62.5%; \
  box-sizing: border-box;\
\}\
\
*, *::before, *::after \{\
  box-sizing: inherit;\
  margin: 0;\
  padding: 0;\
\}\
\
:root \{\
  --bg-site: #f4f6f9;\
  --bg-card: #ffffff;\
  --bg-badge: #007bff;\
  --bg-badge-hot: #dc3545;\
  --btn-bg: #1a1d20;\
  --btn-text: #ffffff;\
  --text-main: #1a1d20;\
  --text-muted: #5a626a;\
  --shadow: rgba(0, 0, 0, 0.06);\
  --border-color: #e9ecef;\
  /* D\'e9grad\'e9 transparent vers la couleur de fond du site */\
  --fade-gradient: linear-gradient(90deg, rgba(244,246,249,0) 0%, rgba(244,246,249,1) 100%);\
\}\
\
@media (prefers-color-scheme: dark) \{\
  :root \{\
    --bg-site: #121212;\
    --bg-card: #1e1e1e;\
    --bg-badge: #0b66c2;\
    --bg-badge-hot: #bb2d3b;\
    --btn-bg: #f8f9fa;\
    --btn-text: #121212;\
    --text-main: #f8f9fa;\
    --text-muted: #a0aec0;\
    --shadow: rgba(0, 0, 0, 0.4);\
    --border-color: #2d2d2d;\
    --fade-gradient: linear-gradient(90deg, rgba(18,18,18,0) 0%, rgba(18,18,18,1) 100%);\
  \}\
\}\
\
/* ==========================================================================\
   2. STYLES G\'c9N\'c9RAUX\
   ========================================================================== */\
body \{\
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;\
  background-color: var(--bg-site);\
  color: var(--text-main);\
  font-size: 1.6rem; \
  line-height: 1.6;\
  padding: 4rem 0; /* On retire le padding horizontal du body pour coller aux bords sur mobile */\
  transition: background-color 0.3s ease, color 0.3s ease;\
\}\
\
.header \{\
  text-align: center;\
  margin-bottom: clamp(3rem, 5vw, 6rem);\
  padding: 0 2rem;\
\}\
\
.header h1 \{\
  font-size: clamp(2.8rem, 4vw, 4rem);\
  margin-bottom: 1rem;\
\}\
\
.header p \{\
  font-size: 1.6rem;\
  color: var(--text-muted);\
\}\
\
/* ==========================================================================\
   3. MISE EN PAGE & INDICATEUR VISUEL (SLIDER / GRID)\
   ========================================================================== */\
.slider-wrapper \{\
  position: relative;\
  width: 100%;\
\}\
\
/* L'indicateur visuel (un d\'e9grad\'e9 flout\'e9 sur le bord droit de l'\'e9cran sur mobile) */\
.slider-wrapper::after \{\
  content: "";\
  position: absolute;\
  top: 0;\
  right: 0;\
  bottom: 0;\
  width: 4rem; /* \'c9paisseur du d\'e9grad\'e9 */\
  background: var(--fade-gradient);\
  pointer-events: none; /* Permet de cliquer \'e0 travers */\
  z-index: 2;\
  transition: opacity 0.3s ease;\
\}\
\
.grid-container \{\
  max-width: 114rem;\
  margin: 0 auto;\
  padding: 2rem;\
\
  /* Mode Slider Mobile par d\'e9faut */\
  display: flex;\
  overflow-x: auto;\
  gap: 2rem;\
  scrollbar-width: none;\
  -ms-overflow-style: none;\
  scroll-snap-type: x mandatory;\
  scroll-behavior: smooth;\
\}\
\
.grid-container::-webkit-scrollbar \{\
  display: none;\
\}\
\
/* D\'e9sactivation du d\'e9grad\'e9 et bascule en Grille sur PC */\
@media (min-width: 768px) \{\
  .slider-wrapper::after \{\
    display: none; /* Plus besoin du d\'e9grad\'e9 visuel si tout est affich\'e9 */\
  \}\
\
  .grid-container \{\
    display: grid;\
    grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr));\
    gap: clamp(2rem, 3vw, 4rem);\
    overflow-x: visible;\
    scroll-snap-type: none;\
  \}\
\}\
\
/* ==========================================================================\
   4. COMPOSANT CARD & BOUTONS\
   ========================================================================== */\
.card \{\
  background-color: var(--bg-card);\
  border: 1px solid var(--border-color);\
  border-radius: 1.2rem;\
  overflow: hidden;\
  box-shadow: 0 1rem 2rem var(--shadow);\
  display: flex;\
  flex-direction: column;\
  transition: transform 0.2s ease, box-shadow 0.2s ease;\
  \
  /* Propri\'e9t\'e9s pour le mode slider mobile */\
  flex: 0 0 28rem;\
  scroll-snap-align: start;\
\}\
\
@media (min-width: 768px) \{\
  .card \{\
    flex: initial;\
    scroll-snap-align: none;\
  \}\
\}\
\
.card:hover \{\
  transform: translateY(-5px);\
  box-shadow: 0 1.5rem 3rem var(--shadow);\
\}\
\
.card-image-placeholder \{\
  height: 18rem;\
  background-color: var(--border-color);\
  display: flex;\
  align-items: center;\
  justify-content: center;\
  font-size: 5rem;\
\}\
\
.card-content \{\
  padding: 2.4rem;\
  display: flex;\
  flex-direction: column;\
  flex-grow: 1;\
  gap: 1.2rem;\
\}\
\
.card-badge \{\
  align-self: flex-start;\
  font-size: 1.1rem;\
  font-weight: bold;\
  text-transform: uppercase;\
  letter-spacing: 0.05em;\
  padding: 0.4em 0.9em; \
  background-color: var(--bg-badge);\
  color: #ffffff;\
  border-radius: 0.4rem;\
\}\
\
.card-badge.badge-hot \{\
  background-color: var(--bg-badge-hot);\
\}\
\
.card-title \{\
  font-size: clamp(2rem, 2.5vw, 2.4rem);\
  font-weight: 700;\
  line-height: 1.2;\
\}\
\
.card-text \{\
  font-size: 1.4rem;\
  color: var(--text-muted);\
  /* Pousse le bouton au bas de la carte m\'eame si le texte est court */\
  margin-bottom: auto; \
\}\
\
/* --- LE BOUTON INTERACTIF ANIM\'c9 --- */\
.card-btn \{\
  display: inline-flex;\
  align-items: center;\
  justify-content: center;\
  gap: 0.8rem;\
  \
  font-size: 1.4rem;\
  font-weight: 600;\
  text-decoration: none;\
  \
  background-color: var(--btn-bg);\
  color: var(--btn-text);\
  padding: 1.2rem 2rem;\
  border-radius: 0.8rem;\
  \
  transition: background-color 0.2s ease, transform 0.1s ease;\
\}\
\
.card-btn .arrow \{\
  display: inline-block;\
  /* Utilisation du EM pour que la fl\'e8che suive proportionnellement la taille du texte */\
  transition: transform 0.2s ease; \
\}\
\
/* Animations au survol du bouton */\
.card-btn:hover \{\
  filter: brightness(1.2); /* \'c9claircit l\'e9g\'e8rement le bouton */\
\}\
\
/* La fl\'e8che se d\'e9cale vers la droite au survol */\
.card-btn:hover .arrow \{\
  transform: translateX(4px);\
\}\
\
/* Effet d'enfoncement au clic (Active state) */\
.card-btn:active \{\
  transform: scale(0.98);\
\}\
