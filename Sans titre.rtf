Voici un exemple de structure HTML standard et s\'e9mantique utilisant correctement la balise 
\f1 \cb3 \uc0\u8234 <section>
\f0 \cb1 \uc0\u8236  au sein d'une page web compl\'e8te :\
\pard\pardeftab720\sl280\partightenfactor0

\f1 \cf2 \cb3 <!DOCTYPE html>\
<\cf4 html\cf2  lang=\cf5 "fr"\cf2 >\
<\cf4 head\cf2 >\
    <\cf4 meta\cf2  charset=\cf5 "UTF-8"\cf2 >\
    <\cf4 title\cf2 >Exemple de Structure S\'e9mantique</\cf4 title\cf2 >\
</\cf4 head\cf2 >\
<\cf4 body\cf2 >\
\
    
\f2\i \cf6 <!-- En-t\'eate principal du site -->
\f1\i0 \cf2 \
    <\cf4 header\cf2 >\
        <\cf4 h1\cf2 >Mon Blog de Voyage</\cf4 h1\cf2 >\
        <\cf4 nav\cf2 >\
            <\cf4 ul\cf2 >\
                <\cf4 li\cf2 ><\cf4 a\cf2  href=\cf5 "#accueil"\cf2 >Accueil</\cf4 a\cf2 ></\cf4 li\cf2 >\
                <\cf4 li\cf2 ><\cf4 a\cf2  href=\cf5 "#articles"\cf2 >Articles</\cf4 a\cf2 ></\cf4 li\cf2 >\
                <\cf4 li\cf2 ><\cf4 a\cf2  href=\cf5 "#contact"\cf2 >Contact</\cf4 a\cf2 ></\cf4 li\cf2 >\
            </\cf4 ul\cf2 >\
        </\cf4 nav\cf2 >\
    </\cf4 header\cf2 >\
\
    
\f2\i \cf6 <!-- Contenu principal unique de la page -->
\f1\i0 \cf2 \
    <\cf4 main\cf2 >\
\
        
\f2\i \cf6 <!-- SECTION 1 : Pr\'e9sentation/H\'e9ro -->
\f1\i0 \cf2 \
        <\cf4 section\cf2  id=\cf5 "accueil"\cf2 >\
            <\cf4 h2\cf2 >Bienvenue sur mon blog</\cf4 h2\cf2 >\
            <\cf4 p\cf2 >D\'e9couvrez mes r\'e9cits d'aventures et mes conseils pour voyager l\'e9ger.</\cf4 p\cf2 >\
        </\cf4 section\cf2 >\
\
        
\f2\i \cf6 <!-- SECTION 2 : Liste d'articles -->
\f1\i0 \cf2 \
        <\cf4 section\cf2  id=\cf5 "articles"\cf2 >\
            <\cf4 h2\cf2 >Derniers articles</\cf4 h2\cf2 >\
            \
            
\f2\i \cf6 <!-- Chaque article est ind\'e9pendant et autonome -->
\f1\i0 \cf2 \
            <\cf4 article\cf2 >\
                <\cf4 h3\cf2 >Mon voyage au Japon</\cf4 h3\cf2 >\
                <\cf4 p\cf2 >R\'e9sum\'e9 de mon s\'e9jour de deux semaines \'e0 Tokyo et Kyoto...</\cf4 p\cf2 >\
            </\cf4 article\cf2 >\
\
            <\cf4 article\cf2 >\
                <\cf4 h3\cf2 >Visiter l'Islande en hiver</\cf4 h3\cf2 >\
                <\cf4 p\cf2 >Conseils pratiques pour affronter le froid et admirer les aurores bor\'e9ales...</\cf4 p\cf2 >\
            </\cf4 article\cf2 >\
        </\cf4 section\cf2 >\
\
        
\f2\i \cf6 <!-- SECTION 3 : Formulaire de contact -->
\f1\i0 \cf2 \
        <\cf4 section\cf2  id=\cf5 "contact"\cf2 >\
            <\cf4 h2\cf2 >Me contacter</\cf4 h2\cf2 >\
            <\cf4 form\cf2 >\
                
\f2\i \cf6 <!-- Formulaire ici -->
\f1\i0 \cf2 \
            </\cf4 form\cf2 >\
        </\cf4 section\cf2 >\
\
    </\cf4 main\cf2 >\
\
    
\f2\i \cf6 <!-- Pied de page -->
\f1\i0 \cf2 \
    <\cf4 footer\cf2 >\
        <\cf4 p\cf2 >&copy; \cf7 2026\cf2  Mon Blog de Voyage</\cf4 p\cf2 >\
    </\cf4 footer\cf2 >\
\
</\cf4 body\cf2 >\
</\cf4 html\cf2 >\
