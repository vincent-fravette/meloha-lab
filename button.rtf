\f2\fs28 \cf2 /* 1. Style de base du bouton (Mobile First) */\
.btn-accessible \{\
  /* R\'e9initialisation des styles par d\'e9faut */\
  border: none;\
  background-color: #0056b3; /* Bleu contrast\'e9 (sup\'e9rieur \'e0 4.5:1 sur fond blanc) */\
  color: #ffffff; /* Blanc pour un contraste maximal */\
  \
  /* Typographie lisible */\
  font-family: system-ui, -apple-system, sans-serif;\
  font-size: 1rem; /* 16px */\
  font-weight: 600;\
  \
  /* Dimensions minimales pour le tactile (Mobile) */\
  min-height: 48px; \
  padding: 12px 24px;\
  border-radius: 6px;\
  \
  /* Alignement et comportement fluide */\
  display: inline-flex;\
  align-items: center;\
  justify-content: center;\
  width: 100%; /* Pleine largeur sur mobile pour faciliter le clic */\
  max-width: 100%;\
  \
  cursor: pointer;\
  position: relative; /* Indispensable pour l'extension de la zone cliquable */\
  transition: background-color 0.2s ease;\
\}\
\
/* 2. \'c9tats interactifs (Survol et Clic) */\
.btn-accessible:hover \{\
  background-color: #004085; /* Version plus sombre pour le retour visuel */\
\}\
\
.btn-accessible:active \{\
  background-color: #002b5c;\
\}\
\
/* 3. Accessibilit\'e9 Clavier (Focus visible obligatoire) */\
.btn-accessible:focus-visible \{\
  outline: 3px solid #ffc107; /* Liser\'e9 jaune tr\'e8s contrast\'e9 */\
  outline-offset: 2px;\
\}\
\
/* 4. Astuce WCAG : Extension invisible de la zone cliquable */\
.btn-accessible::before \{\
  content: "";\
  position: absolute;\
  top: -6px;\
  bottom: -6px;\
  left: -6px;\
  right: -6px;\
  /* Agrandit la zone cible sans modifier le design visuel du bouton */\
\}\
\
/* 5. Adaptation sur \'e9crans plus grands (Tablettes / PC) */\
@media (min-width: 600px) \{\
  .btn-accessible \{\
    width: auto; /* Reprend sa taille naturelle bas\'e9e sur le texte */\
    min-height: 44px; /* Reste conforme aux normes de bureau */\
  \}\
\}\
