\f1\fs28 \cf2 /* R\'e9initialisation de base */\
* \{\
  margin: 0;\
  padding: 0;\
  box-sizing: border-box;\
\}\
\
body \{\
  font-family: 'Segoe UI', sans-serif;\
\}\
\
/* Le conteneur principal */\
.hero \{\
  position: relative; /* Indispensable pour contenir les \'e9l\'e9ments absolus */\
  width: 100%;\
  height: 100vh;      /* Prend toute la hauteur de l'\'e9cran */\
