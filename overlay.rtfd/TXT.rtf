\}\
\
/* L'overlay sombre */\
.hero-overlay \{\
  position: absolute;\
  top: 0;\
  left: 0;\
  width: 100%;\
  height: 100%;\
  background-color: rgba(0, 0, 0, 0.5); /* Noir \'e0 50% d'opacit\'e9 */\
  z-index: 2; /* Se place au-dessus de l'image */\
\}\
\
/* Le contenu textuel */\
.hero-content \{\
  position: relative;\
  z-index: 3; /* Imp\'e9rativement au-dessus de l'overlay */\
  color: #ffffff;\
  text-align: center;\
  max-width: 800px;\
  padding: 0 20px;\
\}\
\
/* Styles du texte et du bouton */\
.hero-content h1 \{\
  font-size: 3rem;\
  margin-bottom: 20px;\
  font-weight: 700;\
\}\
\
