\f1\fs28 \cf2 /* ==========================================\
   1. STYLES DE BASE & STRUCTURE (RESPONSIVE)\
   ========================================== */\
* \{\
  margin: 0;\
  padding: 0;\
  box-sizing: border-box;\
\}\
\
body \{\
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\
  overflow-x: hidden; /* \'c9vite les d\'e9filements horizontaux ind\'e9sirables */\
\}\
\
.hero \{\
  position: relative;\
  width: 100%;\
  height: 100vh; /* Utilise 100dvh si vous voulez \'e9viter les bugs de hauteur sur les navigateurs mobiles */\
  height: 100dvh; \
  overflow: hidden;\
  display: flex;\
  align-items: center;\
  justify-content: center;\
\}\
\
.hero-img \{\
  position: absolute;\
  top: 0;\
  left: 0;\
  width: 100%;\
  height: 100%;\
  object-fit: cover;\
  z-index: 1;\
\}\
\
.hero-overlay \{\
  position: absolute;\
  top: 0;\
  left: 0;\
  width: 100%;\
  height: 100%;\
  background-color: rgba(0, 0, 0, 0.55); /* L\'e9g\'e8rement plus sombre pour le mobile */\
  z-index: 2;\
\}\
\
.hero-content \{\
  position: relative;\
  z-index: 3;\
  color: #ffffff;\
  text-align: center;\
  width: 100%;\
  max-width: 800px;\
  padding: 0 24px; /* Marges de s\'e9curit\'e9 pour les petits \'e9crans */\
\}\
\
/* Typographies responsives avec clamp() */\
.hero-content h1 \{\
  /* clamp(taille_min, taille_fluide, taille_max) */\
  font-size: clamp(2rem, 5vw + 1rem, 3.5rem); \
  margin-bottom: clamp(12px, 3vw, 24px);\
  font-weight: 700;\
  line-height: 1.2;\
\}\
\
.hero-content p \{\
  font-size: clamp(1rem, 1.5vw + 0.5rem, 1.35rem);\
  margin-bottom: clamp(24px, 4vw, 36px);\
  line-height: 1.6;\
  font-weight: 400;\
  color: rgba(255, 255, 255, 0.9);\
\}\
\
.hero-btn \{\
  display: inline-block;\
  padding: clamp(10px, 2vw, 14px) clamp(24px, 4vw, 36px);\
  background-color: #007bff;\
  color: #ffffff;\
  text-decoration: none;\
  border-radius: 6px;\
  font-weight: 600;\
  font-size: clamp(0.95rem, 1vw + 0.5rem, 1.1rem);\
  transition: transform 0.2s ease, background-color 0.2s ease;\
\}\
\
/* Effets au survol (uniquement pour les appareils avec souris) */\
@media (hover: hover) \{\
  .hero-btn:hover \{\
    background-color: #0056b3;\
    transform: translateY(-2px);\
  \}\
\}\
\
/* ==========================================\
   2. ANIMATIONS AU CHARGEMENT (CSS PUR)\
   ========================================== */\
\
/* D\'e9finition de l'animation de mont\'e9e et fondu */\
@keyframes fadeUp \{\
  from \{\
    opacity: 0;\
    transform: translateY(30px);\
  \}\
  to \{\
    opacity: 1;\
    transform: translateY(0);\
  \}\
\}\
\
/* Classe d'animation principale */\
.animate-fade-up \{\
  opacity: 0; /* Masqu\'e9 par d\'e9faut avant le d\'e9marrage */\
  animation: fadeUp 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;\
\}\
\
/* D\'e9calages temporels (Delays) pour un effet de cascade */\
.delay-1 \{\
  animation-delay: 0.2s;\
\}\
\
.delay-2 \{\
  animation-delay: 0.4s;\
\}\
\
/* Optionnel : L\'e9g\'e8re animation d'\'e9chelle sur l'image de fond */\
@keyframes zoomIn \{\
  from \{\
    transform: scale(1.1);\
  \}\
  to \{\
    transform: scale(1);\
  \}\
\}\
\
.hero-img \{\
  animation: zoomIn 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;\
\}\
